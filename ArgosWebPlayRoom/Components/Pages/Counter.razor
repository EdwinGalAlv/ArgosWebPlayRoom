@page "/counter"

@using BlazorMonaco
@using BlazorMonaco.Editor
@using BlazorMonaco.Languages

@* <PageTitle>Counter</PageTitle> *@

@* <MudText Typo="Typo.h3" GutterBottom="true">Counter</MudText> *@

@* <MudText Typo="Typo.body1" Class="mb-4">Current count: @currentCount</MudText> *@

@* <MudButton Color="Color.Primary" Variant="Variant.Filled" @onclick="IncrementCount">Click me</MudButton> *@

<style>
    .editor-container {
        height: 500px;
        width: 100%;
    }

    .monaco-editor {
        height: 100%;
        width: 100%;
    }
</style>

<div class="editor-container">
    <StandaloneCodeEditor Id="my-code-editor" ConstructionOptions="EditorConstructionOptions" CssClass="monaco-editor" />
</div>

@code {
    private StandaloneEditorConstructionOptions EditorConstructionOptions(StandaloneCodeEditor editor)
    {
        return new StandaloneEditorConstructionOptions
            {
                AutomaticLayout = true,
                // Language = "javascript",
                Language = "json",
                Value = "function xyz() {\n" +
                        "   console.log(\"Hello world!\");\n" +
                        "}"
            };
    }
}

@code {
    private int currentCount = 5;

    private void IncrementCount()
    {
        currentCount = currentCount + currentCount++;
    }
}
 @* <MudText Typo="Typo.body1" Class="mt-4">Current count: @currentCount</MudText> *@
@* <MudButton Color="Color.Primary" Variant="Variant.Filled" @onclick="IncrementCount">Click me</MudButton> *@
@* <MudButton Color="Color.Secondary" Variant="Variant.Outlined" @onclick="DecrementCount">Decrement</MudButton> *@