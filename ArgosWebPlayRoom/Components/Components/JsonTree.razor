@namespace MudExtensions
@inherits MudComponentBase


@* <MudTreeView T="string" Class="@Class" Style="@Style" Dense="@Dense" Hover="@Hover" UserAttributes="@UserAttributes"> *@
<MudTreeView T="string" Class="@Class" Style="@Style" Dense="true" Hover="true" UserAttributes="@UserAttributes">
    <MudJsonTreeViewNode Node="Root" Sorted="@Sorted" />
</MudTreeView>


@code {
    // Define la propiedad Root para el nodo raíz del árbol
    private string Root { get; set; } = "RootNode";

    // Define la propiedad Sorted para indicar si los nodos están ordenados
    private bool Sorted { get; set; } = true;
}